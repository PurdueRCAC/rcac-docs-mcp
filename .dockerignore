# Keep the build context small and deterministic. Only pyproject.toml,
# uv.lock, README.md, and src/ are actually needed to build the wheel.

# Version control
.git
.gitignore
.gitmodules

# Local virtual environment / build artifacts
.venv
dist
build
*.egg-info

# Python caches
__pycache__/
*.py[cod]
.pytest_cache

# Editor / IDE
.idea
.vscode

# Tests and the (large) RCAC-Docs submodule fixture — not needed to build/run
tests

# Agent / project meta (not needed in the image)
.agents
.claude
AGENTS.md
CLAUDE.md
ROADMAP.md
INSTRUCTIONS.md

# The image builds its own copy
Dockerfile
.dockerignore
